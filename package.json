{
	"name": "giraffe",
	"version": "0.15.2",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run scripts/dev.ts",
		"login:prod": "cloudflared access login https://giraffe.hexly.ai > /dev/null",
		"factory:audit": "bun run scripts/factory-audit.ts",
		"factory:preview": "bun run scripts/factory-preview.ts",
		"dev:server": "bun run scripts/dev-server.ts",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.scripts.json && bun run scripts/check-wrangler-types.ts && bun run --cwd packages/agent typecheck",
		"build": "vite build && bun run --cwd packages/agent build",
		"lint": "biome check --error-on-warnings .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage && bun run --cwd packages/agent test:coverage",
		"test:e2e:api": "bun run scripts/run-e2e.ts",
		"test:e2e:bdd": "bun run scripts/run-e2e-bdd.ts",
		"gate:test-skip": "bun run scripts/gate-test-skip.ts",
		"gate:wrangler-vars": "bun run scripts/gate-wrangler-vars.ts",
		"gate:github-fetch": "bun run scripts/gate-github-fetch.ts",
		"gate:client-fetch": "bun run scripts/gate-client-fetch.ts",
		"gate:security": "bun run scripts/gate-security.ts",
		"prepare": "husky",
		"test:agent": "bun run --cwd packages/agent test",
		"agent": "node packages/agent/src/cli.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@cloudflare/workers-types": "5.20261014.1",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitest/coverage-v8": "5.0.4",
		"happy-dom": "^20.14.5",
		"husky": "9.1.7",
		"oxc-parser": "^0.154.0",
		"tailwindcss": "^4.3.3",
		"typescript": "7.0.2",
		"vite": "^8.3.4",
		"vitest": "5.0.4",
		"wrangler": "4.151.0"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"dependencies": {
		"@nocoo/basalt": "3.1.0",
		"hono": "^4.13.13",
		"lucide-react": "^1.57.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.4.0",
		"recharts": "^3.10.1",
		"zod": "^4.6.7",
		"@nocoo/giraffe-agent": "workspace:*"
	},
	"overrides": {
		"source-map-js": "^1.2.2",
		"sharp": "^0.35.5"
	}
}
