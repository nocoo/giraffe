{
	"name": "giraffe",
	"version": "0.28.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run scripts/dev.ts",
		"login:prod": "cloudflared access login https://giraffe.hexly.ai > /dev/null",
		"dev:server": "bun run scripts/dev-server.ts",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.scripts.json && bun run scripts/check-wrangler-types.ts",
		"build": "vite build",
		"lint": "biome check --error-on-warnings .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e:api": "bun run scripts/run-e2e.ts",
		"test:e2e:bdd": "bun run scripts/run-e2e-bdd.ts",
		"gate:test-skip": "bun run scripts/gate-test-skip.ts",
		"gate:wrangler-vars": "bun run scripts/gate-wrangler-vars.ts",
		"gate:github-fetch": "bun run scripts/gate-github-fetch.ts",
		"gate:client-fetch": "bun run scripts/gate-client-fetch.ts",
		"gate:security": "bun run scripts/gate-security.ts",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@cloudflare/workers-types": "5.20261023.1",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitest/coverage-v8": "5.0.5",
		"happy-dom": "^21.0.4",
		"husky": "9.1.7",
		"oxc-parser": "^0.155.0",
		"tailwindcss": "^4.3.3",
		"typescript": "7.0.2",
		"vite": "^8.3.5",
		"vitest": "5.0.5",
		"wrangler": "4.152.0"
	},
	"workspaces": [
		"apps/*"
	],
	"dependencies": {
		"@nocoo/basalt": "3.2.1",
		"hono": "^4.13.13",
		"lucide-react": "1.61.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.5.0",
		"recharts": "^3.10.1",
		"zod": "^4.6.7"
	},
	"overrides": {
		"source-map-js": "^1.2.2",
		"sharp": "^0.35.5",
		"undici": "7.30.1"
	}
}
