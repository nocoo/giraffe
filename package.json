{
	"name": "giraffe",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run scripts/dev.ts",
		"dev:server": "bun run scripts/dev-server.ts",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.scripts.json && bun run scripts/check-wrangler-types.ts",
		"build": "vite build",
		"lint": "biome check --error-on-warnings .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e:api": "bun run scripts/run-e2e.ts",
		"test:e2e:bdd": "bun run scripts/run-e2e-bdd.ts",
		"gate:test-skip": "bun run scripts/gate-test-skip.ts",
		"gate:wrangler-vars": "bun run scripts/gate-wrangler-vars.ts",
		"gate:github-fetch": "bun run scripts/gate-github-fetch.ts",
		"gate:client-fetch": "bun run scripts/gate-client-fetch.ts",
		"gate:security": "bun run scripts/gate-security.ts",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@cloudflare/workers-types": "5.20260814.1",
		"@playwright/test": "^1.62.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.0",
		"@vitest/coverage-v8": "4.1.11",
		"happy-dom": "^20.11.6",
		"husky": "9.1.7",
		"oxc-parser": "^0.147.0",
		"tailwindcss": "^4.3.3",
		"typescript": "7.0.2",
		"vite": "^8.2.2",
		"vitest": "4.1.11",
		"wrangler": "4.123.0"
	},
	"dependencies": {
		"@nocoo/basalt": "2.0.0",
		"hono": "^4.13.4",
		"lucide-react": "^1.34.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.3.0",
		"recharts": "^3.10.1",
		"zod": "^4.5.0-canary.20260825T041357"
	}
}
