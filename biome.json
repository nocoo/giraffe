{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error",
				"noNodejsModules": "off",
				"useImportExtensions": "off",
				"noUndeclaredDependencies": "off",
				"noUndeclaredVariables": "off"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noSkippedTests": "error",
				"noFocusedTests": "error",
				"noConsole": "off"
			},
			"complexity": {
				"useMathMinMax": "off"
			},
			"style": {
				"noNonNullAssertion": "error",
				"useConst": "error"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["docs/04-server.md"],
			"formatter": { "enabled": false }
		}
	],
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/coverage",
			"!**/.wrangler",
			"!**/.factory-cache",
			"!**/test-results",
			"!**/playwright-report",
			"!**/bun.lock",
			"!**/*.d.ts",
			"!apps/web/src/client/index.css"
		]
	}
}
